{
  "type": "module",
  "name": "ma-vigne",
  "version": "1.0.0",
  "description": "Application de gestion viticole — GUERETTECH",
  "private": true,
  "scripts": {
    "dev": "node scripts/mv-gt-page.mjs && vite",
    "check": "node scripts/mv-lanceur.mjs",
    "lint": "node scripts/lint-cliquet.mjs",
    "lint:vocabulaire": "node scripts/lint-vocabulaire.mjs",
    "prebuild": "npm run check",
    "build": "node scripts/mv-gt-page.mjs && vite build && node scripts/inject-precache.mjs && node scripts/mv-version-json.mjs",
